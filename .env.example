# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Public origin of this API. Used to build the Roblox OAuth redirect URI, so it
# must match the redirect registered in the Creator Dashboard exactly.
BASE_URL=http://localhost:3001

# Comma separated browser origins allowed to call this API with credentials.
# The first entry is where OAuth returns the user afterwards.
FRONTEND_URL=http://localhost:5173

# --- Data --------------------------------------------------------------------
DATABASE_URL=postgresql://trptools:trptools@localhost:5432/trptools
REDIS_URL=redis://localhost:6379
# Workers use Upstash's connectionless REST API. These may be omitted for an
# Upstash REDIS_URL because its host and password contain the same values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Object storage ----------------------------------------------------------
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=trptools
S3_ACCESS_KEY=GK11111111111111111111111111111111
S3_SECRET_KEY=2222222222222222222222222222222222222222222222222222222222222222
S3_REGION=garage
# Full public bucket URL. Blank uses S3_ENDPOINT/S3_BUCKET.
# Garage image proxy: http://localhost:9000; R2: https://assets.example.com
# R2 also needs its S3 API endpoint, credentials, and S3_REGION=auto.
S3_PUBLIC_URL=http://localhost:9000

# --- Secrets -----------------------------------------------------------------
# Encrypts stored Roblox OAuth tokens and group Open Cloud keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Roblox OAuth ------------------------------------------------------------
# Create an app at https://create.roblox.com/dashboard/credentials
# Enable "group:read" and "group:write" on the app, plus openid and profile.
# Normal sign-in requests read access only. The claimable-ranks dashboard asks
# managers to reverify before storing a separate rank-change authorization.
# Set the redirect URI to <BASE_URL>/auth/callback
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional instance-wide Open Cloud API key, used when a group has not supplied
# its own. Groups configure their own key in group settings, which is preferred
# because per-key rate limits are far higher than per-OAuth-authorization ones.
ROBLOX_API_KEY=

# --- Discord -----------------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# The application id doubles as the OAuth client id and the bot's user id.
# Add BOTH of these to the application's OAuth2 redirect URIs, or Discord
# refuses the redirect and the button that starts it looks broken:
#   <BASE_URL>/bot/callback           the dashboard's "Add to Discord"
#   <BASE_URL>/auth/discord/callback  a member connecting their own account
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Shared secret the trptools-bot process presents on /bot/internal/*. The bot
# acts across every group at once, so it authenticates as a service rather than
# as any one user. Generate with: openssl rand -hex 32
BOT_SERVICE_TOKEN=
BOT_WORKER_URL=
BOT_WORKER_SYNC_TOKEN=

# --- Access ------------------------------------------------------------------
# Comma separated Roblox user IDs granted the site-wide admin rank on login.
SITE_ADMINS=

SESSION_TTL_DAYS=30
# Set when the API and site share a parent domain, e.g. .trptools.com
# COOKIE_DOMAIN=

# Browser push reminders (optional). Generate with bun run scripts/generate-vapid.ts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Random secret for cron-to-worker jobs. Also set as a Worker secret.
BACKGROUND_JOB_TOKEN=
