{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trptools-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "apis.trptools.com", "custom_domain": true }],
  "placement": {
    "region": "aws:us-west-2"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "GLOBAL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "BOT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "vars": {
    "CF_WORKER": "true",
    "NODE_ENV": "production"
  }
}
